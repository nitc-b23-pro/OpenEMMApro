# config/local.env.example
# Copy this to config/local.env (setup_local.sh does this for you) and fill
# in the real paths. train_local.sh reads every setting from config/local.env
# -- it has no built-in defaults, so all of these must be present.

# ---- Environment ------------------------------------------------------------
# CUDA wheel tag setup_local.sh uses to install PyTorch
# (https://download.pytorch.org/whl/<tag>). Check `nvidia-smi` for your
# driver's max supported CUDA version and pick the closest tag: cu118,
# cu121, cu124, cu128, ...
CUDA_TAG=cu124

# Conda environment name used by setup_local.sh / train_local.sh.
OPENEMMA_CONDA_ENV=openemma

# ---- Model ------------------------------------------------------------------
# Local directory holding Qwen2.5-VL-3B-Instruct's weights/config/processor
# files, with preprocessor_config.json already patched for this project's
# transformers/qwen_vl_utils versions. Produced by
# scripts/download_qwen_weights.py -- it prints the right value to paste here.
OPENEMMA_QWEN_PATH=models/qwen2.5-vl-3b-fixed

# ---- Training + validation data ---------------------------------------------
# nuScenes root containing v1.0-trainval/, samples/, maps/ (the path
# scripts/prepare_nuscenes.py prints as OPENEMMA_DATAROOT). With
# v1.0-trainval, training uses the official 700 train scenes and validation
# the official 150 val scenes.
OPENEMMA_TRAIN_DATAROOT=data/nuscenes_trainval
OPENEMMA_TRAIN_VERSION=v1.0-trainval

# ---- Test data ----------------------------------------------------------------
# nuScenes root containing v1.0-test/ (150 scenes); can be the same root as
# above.
OPENEMMA_TEST_DATAROOT=data/nuscenes_test
OPENEMMA_TEST_VERSION=v1.0-test

# ---- Test run options ------------------------------------------------------
# Checkpoint directory to test (e.g. openemma_epoch20). Leave empty to test
# the epoch with the best validation ADE from the training run.
OPENEMMA_TEST_CHECKPOINT=
# true = write per-frame YOLO3D overlays, trajectory plots and scene videos
# during testing; false = metrics only (much faster).
OPENEMMA_TEST_PLOT=true
# 1 = skip training and only run the test step; 0 = train, then test.
OPENEMMA_SKIP_TRAIN=0
