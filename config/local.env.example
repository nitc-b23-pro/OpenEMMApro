# config/local.env.example
# Copy this to config/local.env (setup_local.sh does this for you) and fill
# in the real paths. train_local.sh sources this file before running
# train_openemma.py.

# Local directory holding Qwen2.5-VL-3B-Instruct's weights/config/processor
# files, with preprocessor_config.json already patched for this project's
# transformers/qwen_vl_utils versions. Produced by
# scripts/download_qwen_weights.py -- it prints the right value to paste here.
OPENEMMA_QWEN_PATH=/absolute/path/to/models/qwen2.5-vl-3b-fixed

# Assembled nuScenes root directory (contains v1.0-*/ , maps/, samples/,
# sweeps/). Produced by scripts/prepare_nuscenes.py -- it prints the right
# values to paste here.
OPENEMMA_DATAROOT=/absolute/path/to/data/nuscenes_root
OPENEMMA_VERSION=v1.0-test

# CUDA wheel tag setup_local.sh uses to install PyTorch
# (https://download.pytorch.org/whl/<tag>). Check `nvidia-smi` for your
# driver's max supported CUDA version and pick the closest tag: cu118,
# cu121, cu124, cu128, ...
CUDA_TAG=cu124

# Conda environment name used by setup_local.sh / train_local.sh.
OPENEMMA_CONDA_ENV=openemma
